generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Album {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  relativePath String?
  coverAssetId String?
  sortOrder    Int      @default(0)
  isHidden     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets       Asset[]

  @@index([slug])
  @@index([isHidden])
}

model Asset {
  id             String    @id @default(cuid())
  type           String    // "PHOTO" or "VIDEO"
  albumId        String?
  album          Album?    @relation(fields: [albumId], references: [id])
  filename       String
  originalPath   String
  relativePath   String    @unique
  extension      String
  mimeType       String?
  fileSizeBytes  Int
  width          Int?
  height         Int?
  durationSeconds Float?
  thumbnailPath  String?
  posterPath     String?
  takenAt        DateTime?
  modifiedAt     DateTime
  isHidden       Boolean   @default(false)
  isHighlight    Boolean   @default(false)
  isAvailable    Boolean   @default(true)
  checksum       String?
  blurDataUrl    String?   // tiny base64 placeholder for instant grid rendering
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tags           AssetTag[]

  @@index([type])
  @@index([albumId])
  @@index([filename])
  @@index([takenAt])
  @@index([modifiedAt])
  @@index([isHidden])
  @@index([isAvailable])
}

model SiteSetting {
  id                String    @id @default(cuid())
  appName           String    @default("Wedding Memories")
  coupleNames       String?
  weddingDate       DateTime?
  guestPasswordHash String?
  requirePassword   Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model FuturePerson {
  id           String   @id @default(cuid())
  displayName  String?
  coverAssetId String?
  isVisible    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FutureFaceMatch {
  id              String   @id @default(cuid())
  personId        String
  assetId         String
  boundingBoxJson String?
  confidence      Float?
  provider        String?
  externalFaceId  String?
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Tags organize assets across albums: events, locations, people (faces), auto-clusters.
model Tag {
  id           String     @id @default(cuid())
  kind         String     // "EVENT" | "LOCATION" | "PERSON" | "AUTO"
  name         String
  slug         String     @unique
  coverAssetId String?
  isVisible    Boolean    @default(true)
  sortOrder    Int        @default(0)
  startAt      DateTime?  // time range for EVENT tags (from clustering)
  endAt        DateTime?
  source       String?    // "manual" | "time-cluster" | "clip-cluster" | "face"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assets       AssetTag[]

  @@index([kind])
  @@index([isVisible])
}

model AssetTag {
  assetId   String
  tagId     String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([assetId, tagId])
  @@index([tagId])
}
