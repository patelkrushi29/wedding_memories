# =============================================================================
# Wedding Memories — copy to .env (never commit .env)
# =============================================================================

# --- Database -----------------------------------------------------------------
# Supabase Postgres. Locally the direct host is fine.
# ON VERCEL THIS MUST BE THE POOLER STRING — the direct db.<ref>.supabase.co host
# is IPv6-only and Vercel cannot reach it (every request 500s with an empty body).
#   pooler: postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Cloudflare R2 ------------------------------------------------------------
# R2_PUBLIC_BASE_URL is the only one the gallery needs to *read* images.
# The credentials are for writing: upload:r2 and sync:r2.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="family-photos"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://pub-xxxxx.r2.dev"

# --- Access -------------------------------------------------------------------
# The password guests type. There is no fallback: if this is unset, every login
# is refused rather than a default being accepted. Avoid the obvious words.
GUEST_PASSWORD="change-me"

# Bearer token for the host API behind /admin. Long and random — you paste it
# once, you don't memorise it. Generate: openssl rand -base64 24
# Without it, /admin only works on the local dev server.
ADMIN_REINDEX_SECRET="change-me"

# Passwordless link for parents: /view/<token>. Not built yet (Phase F3).
FAMILY_VIEW_TOKEN="long-random-token-for-family-link"

# --- Display ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wedding Memories"
# Shown as the gallery heading. Falls back to the app name.
NEXT_PUBLIC_COUPLE_NAMES=""

# --- Local only ---------------------------------------------------------------
# Default folder for `npm run upload:r2` when --from is omitted.
# MEDIA_ROOT="./media/wedding"
